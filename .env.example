# .env.example — copy to backend/.env and fill in real values.

# MongoDB Atlas SRV connection string.
# Get it from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# The Atlas database name to use. Created on first write if missing.
DB_NAME="cloud_student_portal"

# Any random string — used to sign Flask session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="change-me-to-a-long-random-string"

# CORS origins (unused by Jinja templates, kept for API compatibility).
CORS_ORIGINS="*"
